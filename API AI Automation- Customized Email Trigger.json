      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item) => {\n  let raw = item.json.text ?? item.json.output ?? item.json;\n\n  // Convert object/array input to string if necessary\n  if (typeof raw !== \"string\") {\n    raw = JSON.stringify(raw);\n  }\n\n  // Remove Markdown JSON code fences\n  raw = raw\n    .trim()\n    .replace(/^```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```$/, \"\")\n    .trim();\n\n  let data;\n\n  try {\n    data = JSON.parse(raw);\n  } catch (error) {\n    data = {\n      error: \"Invalid JSON returned by AI\",\n      details: raw\n    };\n  }\n\n  // Return clean JSON for downstream email integration\n  return {\n    json: data\n  };\n});"
