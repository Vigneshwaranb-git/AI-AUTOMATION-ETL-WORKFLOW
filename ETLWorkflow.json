    {
      "parameters": {
        "jsCode": "\n/**\n * n8n Code Node\n * Cleans and validates multiple student records.\n * Mode: Run Once for All Items\n */\n\nconst items = $input.all();\n\nfunction cleanStudent(student) {\n  // Clean string values and remove extra spaces\n  const cleaned = {};\n\n  for (const [key, value] of Object.entries(student)) {\n    cleaned[key] =\n      typeof value === \"string\"\n        ? value.trim()\n        : value;\n  }\n\n  // Validate email\n  const email = cleaned.Email;\n\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (\n    typeof email !== \"string\" ||\n    !emailRegex.test(email) ||\n    email.toUpperCase() === \"INVALID_EMAIL\"\n  ) {\n    cleaned.Email = \"INVALID_EMAIL\";\n  } else {\n    cleaned.Email = email.toLowerCase();\n  }\n\n  // Clean and validate phone number\n  if (cleaned.Phone !== undefined && cleaned.Phone !== null) {\n    const phone = String(cleaned.Phone).replace(/\\D/g, \"\");\n\n    cleaned.Phone = /^[6-9]\\d{9}$/.test(phone)\n      ? phone\n      : null;\n  }\n\n  // Validate Student_ID\n  if (\n    typeof cleaned.Student_ID !== \"string\" ||\n    cleaned.Student_ID.trim() === \"\"\n  ) {\n    cleaned.Student_ID = null;\n  }\n\n  // Clean name\n  if (typeof cleaned.Name === \"string\") {\n    cleaned.Name = cleaned.Name.replace(/\\s+/g, \" \");\n    if (cleaned.Name === \"\") cleaned.Name = null;\n  }\n\n  // Normalize course and city\n  for (const field of [\"Course\", \"City\"]) {\n    if (typeof cleaned[field] === \"string\") {\n      cleaned[field] = cleaned[field].trim();\n    }\n  }\n\n  // Normalize Fee_Paid to boolean\n  if (typeof cleaned.Fee_Paid === \"string\") {\n    const value = cleaned.Fee_Paid.toLowerCase();\n\n    if ([\"true\", \"yes\", \"1\"].includes(value)) {\n      cleaned.Fee_Paid = true;\n    } else if ([\"false\", \"no\", \"0\"].includes(value)) {\n      cleaned.Fee_Paid = false;\n    } else {\n      cleaned.Fee_Paid = null;\n    }\n  } else if (typeof cleaned.Fee_Paid !== \"boolean\") {\n    cleaned.Fee_Paid = null;\n  }\n\n  // Validate date in YYYY-MM-DD format\n  const date = cleaned.Enrolled_Date;\n  const dateRegex = /^\\d{4}-\\d{2}-\\d{2}$/;\n\n  if (typeof date === \"string\" && dateRegex.test(date)) {\n    const parsed = new Date(`${date}T00:00:00Z`);\n\n    const validDate =\n      !Number.isNaN(parsed.getTime()) &&\n      parsed.toISOString().slice(0, 10) === date;\n\n    cleaned.Enrolled_Date = validDate ? date : null;\n  } else {\n    cleaned.Enrolled_Date = null;\n  }\n\n  return cleaned;\n}\n\n// Parse each incoming n8n item\nfunction parseRecord(item) {\n  let data = item.json;\n\n  // Handle AI output wrapped in a text field\n  if (typeof data === \"string\") {\n    data = JSON.parse(data);\n  } else if (typeof data.output === \"string\") {\n    data = JSON.parse(data.output);\n  } else if (typeof data.text === \"string\") {\n    data = JSON.parse(data.text);\n  }\n\n  // Handle arrays of student records\n  return Array.isArray(data) ? data : [data];\n}\n\nconst results = [];\nconst errors = [];\n\nfor (let i = 0; i < items.length; i++) {\n  try {\n    const records = parseRecord(items[i]);\n\n    for (const record of records) {\n      if (\n        !record ||\n        typeof record !== \"object\" ||\n        Array.isArray(record)\n      ) {\n        errors.push({\n          inputItem: i,\n          error: \"Invalid student record\"\n        });\n        continue;\n      }\n\n      results.push({\n        json: cleanStudent(record)\n      });\n    }\n  } catch (error) {\n    errors.push({\n      inputItem: i,\n      error: \"Could not parse JSON: \" + error.message\n    });\n  }\n}\n\n// Return one output item per student.\n// Invalid JSON records are excluded and reported in a separate output field.\nreturn results.map(item => ({\n  json: {\n    ...item.json,\n    _parseErrors: errors\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
